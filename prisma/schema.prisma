generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String? // nullable since maybe magic link later
  fullName  String
  phone     String?
  createdAt DateTime @default(now())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  quotes    Quote[]
  orders    Order[]
  addresses Address[]
}

model Company {
  id           String  @id @default(uuid())
  companyName  String
  vatNumber    String?
  address      String?
  city         String?
  country      String?
  contactPhone String?

  users User[]
}

model Product {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  sku           String   @unique
  category      String
  price         Float
  stockQuantity Int      @default(0)
  imageUrl      String?
  featured      Boolean  @default(false)
  unit          String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  images     ProductImage[]
  quoteItems QuoteItem[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  imageUrl  String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])
}

enum QuoteStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  EXPIRED
}

model Quote {
  id        String      @id @default(uuid())
  userId    String
  status       QuoteStatus @default(PENDING)
  offeredPrice Float?
  adminNotes   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items QuoteItem[]
}

model QuoteItem {
  id        String  @id @default(uuid())
  quoteId   String
  productId String
  quantity  Int
  notes     String?

  quote   Quote   @relation(fields: [quoteId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  orderNumber String      @unique
  totalAmount Float
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]
}

model OrderItem {
  id            String @id @default(uuid())
  orderId       String
  productId     String
  quantity      Int
  priceSnapshot Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  amount        Float
  mpesaReceipt  String?       @unique
  transactionId String?       @unique
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Address {
  id           String  @id @default(uuid())
  userId       String
  addressLine1 String
  addressLine2 String?
  city         String
  country      String
  postalCode   String

  user User @relation(fields: [userId], references: [id])
}
